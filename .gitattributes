# Normalise line endings so the repository behaves identically on Windows,
# Linux, and macOS. Manifests and results are stored with LF.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cff   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.tex   text eol=lf
*.ps1   text eol=crlf

# Binary: never touch
*.png   binary
*.pdf   binary
*.pt    binary
*.pth   binary
