# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Datasets (never redistribute; obtain from official sources)
data/

# Regenerable intermediates: crops, checkpoints, logs, per-run scratch.
# The frozen manifests under manifests/ and the results under results/ ARE
# part of the artifact and are deliberately not ignored.
work/

# Local build / editor noise
.ipynb_checkpoints/
.vscode/
.idea/
Thumbs.db
.DS_Store
*.swp

# Release archives (rebuild from the folder itself)
publication_release_*.zip

# Current IEEE source, PDF and vector figures are version controlled.
*.log
*.aux
*.out
*.synctex.gz

# Never commit secrets
.env
*.key
*.pem

# Preserve build evidence logs under the document folder.
!document/build_logs/*.log

# Local user report and Office locks are not release artifacts.
verify_output.txt
~$*

# Transient compiler output; named final PDFs remain tracked.
/submission_ieee/main.pdf
/submission_ieee/supplement.pdf
/submission_arxiv/main.pdf
